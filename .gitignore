# Python
__pycache__/
*.py[cod]
*.egg-info/

# 构建产物一律不入库：
# exe 只作为 Release 资产分发，仓库里不存二进制，避免每版多一份 14MB blob
.buildenv/
build/
dist/

# 本地配置与日志
*.log
config.json
state.json

# 临时自检脚本
_probe*.py
_harness*.py
_shot*.png

# 本地开发文档：维护者私有（开发交接、UI 重写交接），不随仓库分发
# tools/publish.py 的 EXCLUDE_PREFIXES 有同样规则，双保险
docs/local/
